# Python cache/build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments and local env files
/venv/
/.venv/
/env/
/.env
/.env.*

# Large files that should be transferred manually or with Git LFS.
# Keep smaller metadata, mappings, processed graph artifacts, test/valid queries,
# reports, and experiment summaries trackable for moving the project to a new laptop.
/kg_giant.csv
/Benchmark data/DDXPlus/release_train_patients.csv
/data/processed/ddxplus/train_queries.csv
/data/processed/ddxplus_v2/train_queries.csv

# Generated reranker training dumps can be large; keep metadata JSON trackable.
/data/processed/reranker/*.jsonl

# Model weights / numeric checkpoint blobs should not live in normal Git.
# Keep small *.json summaries and reports trackable.
/artifacts/checkpoints/**/*.pt
/artifacts/checkpoints/**/*.pth
/artifacts/checkpoints/**/*.ckpt
/artifacts/checkpoints/**/*.npz

# Large per-patient prediction dumps from retrieval/evaluation runs.
# Keep small summary JSON files trackable.
/results/**/predictions.csv
/results/**/by_patient.csv

# Obsolete/generated folders from pre-reorg experiments
/multi-interest/
/Subgraph retrieval/
/legacy/

# Local/generated documents that are not needed for reproducing the pipeline
/Papers/

# Logs and OS/editor noise
*.log
.vscode/
.DS_Store
Thumbs.db
